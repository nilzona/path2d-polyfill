{
  "name": "path2d-polyfill-repo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "format:check": "prettier --check '**' --ignore-unknown",
    "format:write": "prettier --write '**' --ignore-unknown",
    "lint": "eslint .",
    "prepare-release": "changeset",
    "publish-packages": "changeset publish",
    "test": "turbo run test",
    "validate": "pnpm format:check & pnpm lint & pnpm test",
    "version-publish-packages": "changeset version && changeset publish"
  },
  "prettier": "@qlik/prettier-config",
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@qlik/eslint-config": "^2.1.0",
    "@qlik/prettier-config": "^1.1.0",
    "@qlik/tsconfig": "^1.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13"
  }
}
